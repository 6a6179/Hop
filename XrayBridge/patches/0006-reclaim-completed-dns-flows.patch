diff --git a/proxy/tun/hop_dns.go b/proxy/tun/hop_dns.go
new file mode 100644
index 0000000..817e552
--- /dev/null
+++ b/proxy/tun/hop_dns.go
@@ -0,0 +1,130 @@
+package tun
+
+import (
+	"encoding/binary"
+	"io"
+	"net/netip"
+	"slices"
+	"sync"
+
+	"github.com/miekg/dns"
+	"github.com/xtls/xray-core/common/net"
+)
+
+func virtualDNSGateways(c *Config) []netip.Addr {
+	var gateways []netip.Addr
+	for _, raw := range c.Gateway {
+		p, err := netip.ParsePrefix(raw)
+		if err != nil {
+			continue
+		}
+		for _, resolver := range c.DNS {
+			ip, err := netip.ParseAddr(resolver)
+			if err == nil && ip.Unmap() == p.Addr().Unmap() {
+				gateways = append(gateways, ip.Unmap())
+				break
+			}
+		}
+	}
+	return gateways
+}
+
+type dnsKey struct {
+	id, qtype uint16
+	name      string
+}
+
+const trackedDNSQuestions = 8
+
+// Only inspect bounded, complete standard IN queries/replies. Use the existing DNS
+// decoder for compressed names and typed records; retain just the question, never RDATA.
+func questionKey(packet []byte, reply bool) (dnsKey, bool) {
+	if len(packet) < 12 || len(packet) > 4096 || binary.BigEndian.Uint16(packet[4:6]) != 1 {
+		return dnsKey{}, false
+	}
+	flags := binary.BigEndian.Uint16(packet[2:4])
+	if (flags&0x8000 != 0) != reply || flags&0x7a40 != 0 {
+		return dnsKey{}, false
+	} // opcode, truncation or reserved Z bit
+	an, ns, ar := int(binary.BigEndian.Uint16(packet[6:8])), int(binary.BigEndian.Uint16(packet[8:10])), int(binary.BigEndian.Uint16(packet[10:12]))
+	if an+ns+ar > 32 || (!reply && (an != 0 || ns != 0 || flags&15 != 0)) {
+		return dnsKey{}, false
+	}
+	name, off, err := dns.UnpackDomainName(packet, 12)
+	if err != nil || len(packet)-off < 4 || binary.BigEndian.Uint16(packet[off+2:]) != dns.ClassINET {
+		return dnsKey{}, false
+	}
+	key := dnsKey{binary.BigEndian.Uint16(packet), binary.BigEndian.Uint16(packet[off:]), dns.CanonicalName(name)}
+	off += 4
+	for range an + ns + ar {
+		rr, end, err := dns.UnpackRR(packet, off)
+		if err != nil || (rr.Header().Rdlength == 0 && rr.Header().Rrtype != dns.TypeOPT) {
+			return dnsKey{}, false
+		}
+		off = end
+	}
+	return key, off == len(packet)
+}
+
+type udpDNSExchange struct {
+	// The handler mutex protects keys, pending and opaque. Keep completed keys so
+	// a delayed duplicate response cannot satisfy a later reuse of the same query.
+	keys    []dnsKey
+	pending uint8
+	opaque  bool
+	// This mutex serializes delivery against retiring/replacing this particular source.
+	writeMu sync.Mutex
+	retired bool
+}
+
+func (d *udpDNSExchange) wouldReuse(key dnsKey) bool {
+	return len(d.keys) >= trackedDNSQuestions || slices.Contains(d.keys, key)
+}
+
+func (d *udpDNSExchange) request(key dnsKey, valid bool) {
+	if d.opaque {
+		return
+	}
+	if !valid || d.wouldReuse(key) {
+		d.opaque = true
+		d.keys = nil
+		return
+	}
+	d.pending |= 1 << len(d.keys)
+	d.keys = append(d.keys, key)
+}
+
+func (d *udpDNSExchange) retire() {
+	d.writeMu.Lock()
+	d.retired = true
+	d.writeMu.Unlock()
+}
+
+func (c *udpConn) writePacket(packet []byte, from net.Destination, sameGateway bool) error {
+	d := c.dns
+	if d == nil {
+		return c.handler.writePacket(packet, from, c.src)
+	}
+	d.writeMu.Lock()
+
+	if d.retired {
+		d.writeMu.Unlock()
+		return io.ErrClosedPipe
+	}
+	err := c.handler.writePacket(packet, from, c.src)
+	if err != nil || !sameGateway {
+		d.writeMu.Unlock()
+		return err
+	}
+	key, ok := questionKey(packet, true)
+	c.handler.Lock()
+	if ok {
+		if i := slices.Index(d.keys, key); i >= 0 {
+			d.pending &^= 1 << i
+		}
+	}
+	// Publish completion and release the writer together before a new question checks for rollover.
+	d.writeMu.Unlock()
+	c.handler.Unlock()
+	return nil
+}
diff --git a/proxy/tun/hop_dns_test.go b/proxy/tun/hop_dns_test.go
new file mode 100644
index 0000000..375b708
--- /dev/null
+++ b/proxy/tun/hop_dns_test.go
@@ -0,0 +1,333 @@
+package tun
+
+import (
+	"errors"
+	"io"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+var testDNSGateway = net.UDPDestination(net.ParseAddress("172.19.0.1"), 53)
+
+func testDNSPacket(t *testing.T, id uint16, typ dnsmessage.Type, reply bool) []byte {
+	t.Helper()
+	m := dnsmessage.Message{Header: dnsmessage.Header{ID: id, Response: reply}, Questions: []dnsmessage.Question{{Name: dnsmessage.MustNewName("example.test."), Type: typ, Class: dnsmessage.ClassINET}}}
+	if reply {
+		m.RCode = dnsmessage.RCodeNameError
+	}
+	b, e := m.Pack()
+	if e != nil {
+		t.Fatal(e)
+	}
+	return b
+}
+func testDNSHandler(t *testing.T) *udpConnectionHandler {
+	u := newUdpConnectionHandler(func(net.Conn, net.Destination) {}, func([]byte, net.Destination, net.Destination) error { return nil })
+	u.dnsGateways = map[net.Destination]bool{testDNSGateway: true}
+	t.Cleanup(u.close)
+	return u
+}
+func testUDPSrc(port int) net.Destination {
+	return net.UDPDestination(net.ParseAddress("172.19.0.2"), net.Port(port))
+}
+func sendTestUDP(u *udpConnectionHandler, port int, dst net.Destination, p []byte) *udpConn {
+	b := buf.New()
+	b.Write(p)
+	src := testUDPSrc(port)
+	u.HandlePacket(src, dst, b)
+	u.RLock()
+	defer u.RUnlock()
+	return u.udpConns[src]
+}
+func answerTestDNS(t *testing.T, c *udpConn, b []byte) {
+	t.Helper()
+	if _, e := c.Write(b); e != nil {
+		t.Fatal(e)
+	}
+}
+func occupyOtherSources(u *udpConnectionHandler) {
+	for i := 1; i < udpFlowLimit; i++ {
+		sendTestUDP(u, 4000+i, net.UDPDestination(testDNSGateway.Address, 443), []byte{0x31})
+	}
+}
+
+func TestHopDNSReclaimsCompletedPipelinedSources(t *testing.T) {
+	u := testDNSHandler(t)
+	a := testDNSPacket(t, 7, dnsmessage.TypeA, false)
+	aaaa := testDNSPacket(t, 7, dnsmessage.TypeAAAA, false)
+	ra := testDNSPacket(t, 7, dnsmessage.TypeA, true)
+	raaaa := testDNSPacket(t, 7, dnsmessage.TypeAAAA, true)
+	for i := 0; i < 512; i++ {
+		c := sendTestUDP(u, 10000+i, testDNSGateway, a)
+		if c == nil || sendTestUDP(u, 10000+i, testDNSGateway, aaaa) != c {
+			t.Fatalf("source %d lost", i+1)
+		}
+		// Consume both requests just as the DNS outbound does before concurrent lookups complete.
+		for range 2 {
+			mb, e := c.ReadMultiBuffer()
+			if e != nil {
+				t.Fatal(e)
+			}
+			buf.ReleaseMulti(mb)
+		}
+		answerTestDNS(t, c, raaaa)
+		answerTestDNS(t, c, ra)
+	}
+	if n := len(u.udpConns); n != udpFlowLimit {
+		t.Fatalf("flow count %d", n)
+	}
+}
+
+func TestHopDNSPreservesPendingAndStaleOwnership(t *testing.T) {
+	u := testDNSHandler(t)
+	occupyOtherSources(u)
+	const source = 18001
+	a := testDNSPacket(t, 1, dnsmessage.TypeA, false)
+	aaaa := testDNSPacket(t, 2, dnsmessage.TypeAAAA, false)
+	ra := testDNSPacket(t, 1, dnsmessage.TypeA, true)
+	raaaa := testDNSPacket(t, 2, dnsmessage.TypeAAAA, true)
+	c := sendTestUDP(u, source, testDNSGateway, a)
+	sendTestUDP(u, source, testDNSGateway, aaaa)
+	blocked := func() {
+		t.Helper()
+		if sendTestUDP(u, source+1, testDNSGateway, a) != nil {
+			t.Fatal("evicted an unresolved or non-DNS source")
+		}
+	}
+	answerTestDNS(t, c, ra)
+	answerTestDNS(t, c, ra)
+	blocked()
+	answerTestDNS(t, c, testDNSPacket(t, 2, dnsmessage.TypeA, true))
+	blocked()
+	bad := append([]byte{}, raaaa...)
+	bad[7] = 1 // missing declared answer
+	answerTestDNS(t, c, bad)
+	blocked()
+	b := buf.New()
+	b.Write(raaaa)
+	other := net.UDPDestination(net.ParseAddress("192.0.2.53"), 53)
+	b.UDP = &other
+	if err := c.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+		t.Fatal(err)
+	}
+	blocked()
+	send := u.writePacket
+	u.writePacket = func([]byte, net.Destination, net.Destination) error { return io.ErrShortWrite }
+	if _, err := c.Write(raaaa); !errors.Is(err, io.ErrShortWrite) {
+		t.Fatal(err)
+	}
+	blocked()
+	u.writePacket = send
+	answerTestDNS(t, c, raaaa)
+	// A new query before eviction puts the same source back into the pending set.
+	q3 := testDNSPacket(t, 3, dnsmessage.TypeA, false)
+	sendTestUDP(u, source, testDNSGateway, q3)
+	blocked()
+	answerTestDNS(t, c, testDNSPacket(t, 3, dnsmessage.TypeA, true))
+	next := sendTestUDP(u, source+1, testDNSGateway, a)
+	if next == nil {
+		t.Fatal("complete source occupied the last slot")
+	}
+	answerTestDNS(t, next, ra)
+	reused := sendTestUDP(u, source, testDNSGateway, a)
+	if reused == nil || reused == c {
+		t.Fatal("source reuse failed")
+	}
+	if _, err := c.Write(ra); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("retired source wrote: %v", err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if u.udpConns[c.src] != reused {
+		t.Fatal("old Close removed the new owner")
+	}
+	blocked() // old reply did not satisfy the new request
+}
+
+func TestHopDNSGatewayScopeAndAmbiguity(t *testing.T) {
+	gateways := virtualDNSGateways(&Config{Gateway: []string{"172.19.0.1/30", "fdfe:dcba:9876::1/126", "192.0.2.53/24"}, DNS: []string{"fdfe:dcba:9876:0:0:0:0:1", "172.19.0.1", "192.0.2.54"}})
+	if len(gateways) != 2 || gateways[0] != netip.MustParseAddr("172.19.0.1") || gateways[1] != netip.MustParseAddr("fdfe:dcba:9876::1") {
+		t.Fatal(gateways)
+	}
+	other := net.UDPDestination(net.ParseAddress("192.0.2.53"), 53)
+	for _, kind := range []string{"mixed", "duplicate", "malformed", "overflow", "external DNS", "other port"} {
+		t.Run(kind, func(t *testing.T) {
+			u := testDNSHandler(t)
+			occupyOtherSources(u)
+			dst := testDNSGateway
+			if kind == "external DNS" {
+				dst = other
+			}
+			if kind == "other port" {
+				dst.Port = 443
+			}
+			q := testDNSPacket(t, 0, dnsmessage.TypeA, false)
+			r := testDNSPacket(t, 0, dnsmessage.TypeA, true)
+			c := sendTestUDP(u, 12000, dst, q)
+			switch kind {
+			case "mixed":
+				sendTestUDP(u, 12000, other, q)
+			case "duplicate":
+				sendTestUDP(u, 12000, dst, q)
+			case "malformed":
+				sendTestUDP(u, 12000, dst, []byte{2})
+			case "overflow":
+				for i := 1; i <= 8; i++ {
+					sendTestUDP(u, 12000, dst, testDNSPacket(t, uint16(i), dnsmessage.TypeA, false))
+					answerTestDNS(t, c, testDNSPacket(t, uint16(i), dnsmessage.TypeA, true))
+				}
+			}
+			answerTestDNS(t, c, r)
+			if sendTestUDP(u, 12001, testDNSGateway, q) != nil {
+				t.Fatal("reclaimed ambiguous or ordinary UDP")
+			}
+		})
+	}
+}
+func TestHopDNSBoundsDispatchDuringEviction(t *testing.T) {
+	started := make(chan *udpConn, 2*udpFlowLimit)
+	release := make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	u := newUdpConnectionHandler(func(c net.Conn, _ net.Destination) { started <- c.(*udpConn); <-release }, func([]byte, net.Destination, net.Destination) error { return nil })
+	u.dnsGateways = map[net.Destination]bool{testDNSGateway: true}
+	defer u.close()
+	q := testDNSPacket(t, 1, dnsmessage.TypeA, false)
+	r := testDNSPacket(t, 1, dnsmessage.TypeA, true)
+	for i := range udpFlowLimit {
+		sendTestUDP(u, 3000+i, testDNSGateway, q)
+	}
+	for range udpFlowLimit {
+		select {
+		case c := <-started:
+			answerTestDNS(t, c, r)
+		case <-time.After(2 * time.Second):
+			t.Fatal("initial handler not admitted")
+		}
+	}
+	for i := range udpFlowLimit {
+		if sendTestUDP(u, 6000+i, testDNSGateway, q) == nil {
+			t.Fatal("replacement rejected", i)
+		}
+	}
+	if sendTestUDP(u, 7000, testDNSGateway, q) != nil {
+		t.Fatal("pending table exceeded bound")
+	}
+	select {
+	case <-started:
+		t.Fatal("more than 64 dispatchers")
+	default:
+	}
+	unblock()
+	for range udpFlowLimit {
+		select {
+		case <-started:
+		case <-time.After(2 * time.Second):
+			t.Fatal("queued handler stalled")
+		}
+	}
+}
+
+func TestHopDNSRejectedQueriesDoNotRetainMappings(t *testing.T) {
+	u := testDNSHandler(t)
+	u.budget = &atomic.Int32{}
+	q := testDNSPacket(t, 1, dnsmessage.TypeA, false)
+	u.budget.Store(udpStackBytes)
+	if sendTestUDP(u, 17000, testDNSGateway, q) != nil {
+		t.Fatal("empty mapping for dropped packet")
+	}
+	u.budget.Store(0)
+	occupyOtherSources(u)
+	c := sendTestUDP(u, 17000, testDNSGateway, q)
+	mb, e := c.ReadMultiBuffer()
+	if e != nil {
+		t.Fatal(e)
+	}
+	buf.ReleaseMulti(mb)
+	answerTestDNS(t, c, testDNSPacket(t, 1, dnsmessage.TypeA, true))
+	baseline := u.budget.Load()
+	u.budget.Store(udpStackBytes)
+	sendTestUDP(u, 17000, testDNSGateway, testDNSPacket(t, 2, dnsmessage.TypeA, false))
+	u.budget.Store(baseline)
+	if sendTestUDP(u, 17001, testDNSGateway, q) == nil {
+		t.Fatal("unadmitted question prevented reclamation")
+	}
+}
+
+func TestHopDNSRetirementWaitsForDelivery(t *testing.T) {
+	u := testDNSHandler(t)
+	occupyOtherSources(u)
+	q := testDNSPacket(t, 7, dnsmessage.TypeAAAA, false)
+	r := testDNSPacket(t, 7, dnsmessage.TypeAAAA, true)
+	c := sendTestUDP(u, 15000, testDNSGateway, q)
+	answerTestDNS(t, c, r)
+	entered, release := make(chan struct{}), make(chan struct{})
+	u.writePacket = func([]byte, net.Destination, net.Destination) error { close(entered); <-release; return nil }
+	done := make(chan error, 1)
+	go func() { _, e := c.Write(r); done <- e }()
+	<-entered
+	if sendTestUDP(u, 15001, testDNSGateway, q) != nil {
+		t.Error("reclaimed with a write in flight")
+	}
+	closed := make(chan struct{})
+	go func() { u.close(); close(closed) }()
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("close deadlocked with pending write")
+	}
+	if _, err := c.Write(r); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("write after close: %v", err)
+	}
+}
+
+func TestHopDNSQuiescentSourceRenewsHistory(t *testing.T) {
+	u := testDNSHandler(t)
+	occupyOtherSources(u)
+	const port = 20000
+	var old *udpConn
+	for i := 0; i < 24; i++ {
+		// Overflow the history once, then issue the very same question sequentially.
+		id := uint16(min(i, 12))
+		q := testDNSPacket(t, id, dnsmessage.TypeA, false)
+		r := testDNSPacket(t, id, dnsmessage.TypeA, true)
+		c := sendTestUDP(u, port, testDNSGateway, q)
+		if c == nil {
+			t.Fatal("failed to renew source", i)
+		}
+		if (i == trackedDNSQuestions || i > 12) && c == old {
+			t.Fatal("retained ambiguous history", i)
+		}
+		if old != nil && c != old {
+			if _, e := old.Write(r); !errors.Is(e, io.ErrClosedPipe) {
+				t.Fatal("stale writer survived rollover", i)
+			}
+		}
+		if sendTestUDP(u, port+1, testDNSGateway, q) != nil {
+			t.Fatal("reclaimed pending query", i)
+		}
+		mb, e := c.ReadMultiBuffer()
+		if e != nil {
+			t.Fatal(e)
+		}
+		buf.ReleaseMulti(mb)
+		answerTestDNS(t, c, r)
+		old = c
+	}
+	if sendTestUDP(u, port+1, testDNSGateway, testDNSPacket(t, 77, dnsmessage.TypeA, false)) == nil {
+		t.Fatal("completed busy source retained a slot")
+	}
+}
