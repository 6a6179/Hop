+package dns
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"testing"
+
+	wire "github.com/miekg/dns"
+	"github.com/xtls/xray-core/common/session"
+)
+
+type hopDoHTransport func(*http.Request) (*http.Response, error)
+
+func (f hopDoHTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestHopDoHWireUsesConfiguredResolver(t *testing.T) {
+	var query, reply wire.Msg
+	query.SetQuestion("example.", wire.TypeHTTPS)
+	packet, _ := query.Pack()
+	reply.SetReply(&query)
+	rr, err := wire.NewRR("example. 20 IN HTTPS 1 target.example. alpn=h2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	reply.Answer = []wire.RR{rr}
+	want, _ := reply.Pack()
+	doh := &DoHNameServer{dohURL: "https://resolver.test/dns-query", cacheController: &CacheController{name: "test"}}
+	doh.httpClient = &http.Client{Transport: hopDoHTransport(func(r *http.Request) (*http.Response, error) {
+		inbound := session.InboundFromContext(r.Context())
+		content := session.ContentFromContext(r.Context())
+		got, err := io.ReadAll(r.Body)
+		if err != nil || !bytes.Equal(got, packet) || r.URL.String() != doh.dohURL || r.Method != "POST" || inbound == nil || inbound.Tag != "dns-query" || content == nil || !content.SkipDNSResolve {
+			t.Fatal("wrong resolver, route or query", err)
+		}
+		return &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(bytes.NewReader(want))}, nil
+	})}
+	for _, disableFallback := range []bool{false, true} {
+		resolver := &DNS{ctx: context.Background(), disableFallback: disableFallback,
+			clients: []*Client{{server: &FakeDNSServer{}}, {server: doh, tag: "dns-query"}}}
+		got, err := resolver.ExchangeWire(context.Background(), query.Question[0], packet)
+		if err != nil || !bytes.Equal(got, want) {
+			t.Fatalf("lost HTTPS answer (disableFallback=%t): %v", disableFallback, err)
+		}
+	}
+}
