diff --git a/proxy/dns/hop_wire.go b/proxy/dns/hop_wire.go
new file mode 100644
index 0000000..8723ca1
--- /dev/null
+++ b/proxy/dns/hop_wire.go
@@ -0,0 +1,80 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	wire "github.com/miekg/dns"
+	"github.com/xtls/xray-core/common/buf"
+	dnsproto "github.com/xtls/xray-core/common/protocol/dns"
+	"github.com/xtls/xray-core/common/signal"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+type wireDNSClient interface {
+	ExchangeWire(context.Context, wire.Question, []byte) ([]byte, error)
+}
+
+func (h *Handler) startWireQuery(ctx context.Context, client wireDNSClient, packet *buf.Buffer, id uint16, qtype dnsmessage.Type, domain string, writer dnsproto.MessageWriter, udp bool, timer *signal.ActivityTimer) error {
+	if !tryAcquireDNSLookup() {
+		packet.Release()
+		return h.rejectNonIPQuery(id, qtype, domain, writer, dnsmessage.RCodeServerFailure)
+	}
+	go func() {
+		defer releaseDNSLookup()
+		defer packet.Release()
+		var query wire.Msg
+		if err := query.Unpack(packet.Bytes()); err != nil || query.Response || query.Opcode != wire.OpcodeQuery || len(query.Question) != 1 {
+			if ctx.Err() == nil {
+				_ = h.rejectNonIPQuery(id, qtype, domain, writer, dnsmessage.RCodeFormatError)
+			}
+			return
+		}
+		raw, err := client.ExchangeWire(ctx, query.Question[0], packet.Bytes())
+		if ctx.Err() != nil {
+			return
+		}
+		if err == nil {
+			raw, err = wireReply(&query, raw, udp)
+		}
+		if err != nil {
+			err = h.rejectNonIPQuery(id, qtype, domain, writer, dnsmessage.RCodeServerFailure)
+		} else {
+			err = writer.WriteMessage(buf.FromBytes(raw))
+		}
+		if err != nil {
+			timer.SetTimeout(0)
+		}
+	}()
+	return nil
+}
+
+// Preserve answer, authority, additional records and upstream RCODE on the
+// wire. A short TC reply makes oversized UDP answers retryable over TCP.
+func wireReply(query *wire.Msg, raw []byte, udp bool) ([]byte, error) {
+	var reply wire.Msg
+	if len(raw) > wire.MaxMsgSize || reply.Unpack(raw) != nil || !reply.Response ||
+		reply.Id != query.Id || reply.Opcode != query.Opcode || len(reply.Question) != 1 {
+		return nil, errors.New("invalid DNS reply")
+	}
+	q, r := query.Question[0], reply.Question[0]
+	if q.Qtype != r.Qtype || q.Qclass != r.Qclass || !strings.EqualFold(q.Name, r.Name) {
+		return nil, errors.New("unexpected DNS reply question")
+	}
+	if udp {
+		limit := wire.MinMsgSize
+		if opt := query.IsEdns0(); opt != nil {
+			limit = max(limit, min(1232, int(opt.UDPSize())))
+		}
+		if len(raw) > limit {
+			reply.Truncated = true
+			reply.Answer, reply.Ns, reply.Extra = nil, nil, nil
+			if reply.Rcode > 15 {
+				reply.SetEdns0(uint16(limit), false)
+			}
+			return reply.Pack()
+		}
+	}
+	return raw, nil
+}
