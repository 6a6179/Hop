+++ b/app/dns/hop_wire_local_darwin_test.go
@@ -0,0 +1,79 @@
+//go:build darwin && cgo
+
+package dns
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/miekg/dns"
+)
+
+func TestHopSystemWireRecords(t *testing.T) {
+	query := new(dns.Msg)
+	query.SetQuestion("alias.example.", dns.TypeTXT)
+	query.Id = 0xabcd
+	packet, err := query.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := newDarwinWireReply(query.Question[0], packet)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result.appendRecord("alias.example.", dns.TypeCNAME, dns.ClassINET, 45, []byte{3, 'd', 's', 't', 7, 'e', 'x', 'a', 'm', 'p', 'l', 'e', 0})
+	if result.sawAnswer || result.err != nil {
+		t.Fatalf("intermediate CNAME treated as final: %+v", result)
+	}
+	result.appendRecord("dst.example.", dns.TypeTXT, dns.ClassINET, 70, []byte{2, 'o', 'k'})
+	result.appendRecord("dst.example.", dns.TypeTXT, dns.ClassINET, 60, []byte{3, 't', 'w', 'o'})
+	var reply dns.Msg
+	if !result.sawAnswer || result.err != nil {
+		t.Fatal(result.err)
+	}
+	if err := reply.Unpack(result.packet); err != nil {
+		t.Fatal(err)
+	}
+	if !reply.Response || !reply.RecursionDesired || reply.Id != query.Id || len(reply.Question) != 1 ||
+		reply.Question[0] != query.Question[0] || len(reply.Answer) != 3 ||
+		reply.Answer[0].(*dns.CNAME).Target != "dst.example." || reply.Answer[1].(*dns.TXT).Txt[0] != "ok" ||
+		reply.Answer[2].Header().Ttl != 60 {
+		t.Fatalf("unexpected system answer: %v", &reply)
+	}
+}
+
+func TestHopSystemWireNegativeAndInvalidResults(t *testing.T) {
+	q := dns.Question{Name: "host.example.", Qclass: dns.ClassINET, Qtype: dns.TypeHTTPS}
+	for _, tc := range []struct {
+		status int32
+		code   int
+	}{{darwinNoSuchName, dns.RcodeNameError}, {darwinNoSuchRecord, dns.RcodeSuccess}} {
+		result, err := newDarwinWireReply(q, make([]byte, 12))
+		if err != nil {
+			t.Fatal(err)
+		}
+		result.finishStatus(tc.status)
+		var reply dns.Msg
+		if err := reply.Unpack(result.packet); err != nil {
+			t.Fatal(err)
+		}
+		if !result.done || result.err != nil || reply.Rcode != tc.code || len(reply.Answer) != 0 {
+			t.Fatalf("negative response: %v, %v", &reply, result.err)
+		}
+	}
+	result, err := newDarwinWireReply(q, make([]byte, 12))
+	if err != nil {
+		t.Fatal(err)
+	}
+	result.appendRecord(q.Name, q.Qtype, q.Qclass, 60, make([]byte, dns.MaxMsgSize))
+	if result.err == nil || len(result.packet) > dns.MaxMsgSize {
+		t.Fatal("oversized answer accepted")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := new(LocalNameServer).exchangeWire(ctx, q, make([]byte, 12)); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled lookup: %v", err)
+	}
+}
