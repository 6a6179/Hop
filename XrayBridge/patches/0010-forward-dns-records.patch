+package dns
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	wire "github.com/miekg/dns"
+)
+
+func TestHopWireReplies(t *testing.T) {
+	for _, rr := range []string{
+		"service.example. 60 IN TXT \"ok\"",
+		"service.example. 60 IN SRV 0 5 443 target.example.",
+		"service.example. 60 IN HTTPS 1 target.example. alpn=h2",
+	} {
+		answer, err := wire.NewRR(rr)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var query, reply wire.Msg
+		query.SetQuestion(answer.Header().Name, answer.Header().Rrtype)
+		reply.SetReply(&query)
+		reply.Answer = []wire.RR{answer}
+		raw, err := reply.Pack()
+		if err != nil {
+			t.Fatal(err)
+		}
+		forwarded, err := wireReply(&query, raw, true)
+		if err != nil || !bytes.Equal(raw, forwarded) {
+			t.Fatalf("reply for %s: %v", rr, err)
+		}
+		reply.Id++
+		badID, _ := reply.Pack()
+		if _, err := wireReply(&query, badID, false); err == nil {
+			t.Fatal("accepted different transaction")
+		}
+	}
+}
+
+func TestHopWireNegativeAndTruncatedReplies(t *testing.T) {
+	var query, reply wire.Msg
+	query.SetQuestion("example.", wire.TypeTXT)
+	reply.SetRcode(&query, wire.RcodeNameError)
+	soa, err := wire.NewRR("example. 30 IN SOA ns.example. host.example. 1 2 3 4 5")
+	if err != nil {
+		t.Fatal(err)
+	}
+	reply.Ns = []wire.RR{soa}
+	negative, _ := reply.Pack()
+	if out, err := wireReply(&query, negative, true); err != nil || !bytes.Equal(negative, out) {
+		t.Fatal("lost negative authority", err)
+	}
+	reply.SetReply(&query)
+	reply.Answer = []wire.RR{&wire.TXT{Hdr: wire.RR_Header{Name: "example.", Rrtype: wire.TypeTXT, Class: wire.ClassINET}, Txt: []string{strings.Repeat("a", 250), strings.Repeat("b", 250), strings.Repeat("c", 250)}}}
+	raw, _ := reply.Pack()
+	out, err := wireReply(&query, raw, true)
+	var truncated wire.Msg
+	if err != nil || truncated.Unpack(out) != nil || !truncated.Truncated || len(truncated.Answer) != 0 || len(out) > 512 {
+		t.Fatal("invalid UDP truncation", err)
+	}
+	if out, err = wireReply(&query, raw, false); err != nil || !bytes.Equal(out, raw) {
+		t.Fatal("lost full TCP response", err)
+	}
+	query.SetEdns0(1232, false)
+	if out, err = wireReply(&query, raw, true); err != nil || !bytes.Equal(out, raw) {
+		t.Fatal("lost full EDNS response", err)
+	}
+}
