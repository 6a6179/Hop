diff --git a/app/dns/hop_wire.go b/app/dns/hop_wire.go
new file mode 100644
index 0000000..de8485e
--- /dev/null
+++ b/app/dns/hop_wire.go
@@ -0,0 +1,51 @@
+package dns
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"time"
+
+	wire "github.com/miekg/dns"
+	"github.com/xtls/xray-core/common/session"
+)
+
+type wireServer interface {
+	exchangeWire(context.Context, wire.Question, []byte) ([]byte, error)
+}
+
+// ExchangeWire retains the preset's resolver and the inbound tag used for its
+// proxy/direct policy. FakeDNS only synthesizes addresses and is skipped here.
+func (s *DNS) ExchangeWire(ctx context.Context, q wire.Question, packet []byte) ([]byte, error) {
+	var lastErr error
+	clients := s.sortClientsFor(strings.TrimSuffix(q.Name, "."), func(client *Client) bool {
+		_, ok := client.server.(wireServer)
+		return ok
+	})
+	for _, client := range clients {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		timeout := client.timeoutMs
+		if timeout <= 0 {
+			timeout = 4 * time.Second
+		}
+		resolverCtx, cancel := context.WithTimeout(ctx, timeout)
+		resolverCtx = session.ContextWithInbound(resolverCtx, &session.Inbound{Tag: client.tag})
+		resolverCtx = session.ContextWithContent(resolverCtx, &session.Content{Protocol: "https", SkipDNSResolve: true})
+		response, err := client.server.(wireServer).exchangeWire(resolverCtx, q, packet)
+		cancel()
+		if err == nil {
+			return response, nil
+		}
+		lastErr = err
+	}
+	if lastErr == nil {
+		lastErr = errors.New("no configured resolver supports wire queries")
+	}
+	return nil, lastErr
+}
+
+func (s *DoHNameServer) exchangeWire(ctx context.Context, _ wire.Question, packet []byte) ([]byte, error) {
+	return s.dohHTTPSContext(ctx, packet)
+}
diff --git a/app/dns/hop_wire_local_darwin.go b/app/dns/hop_wire_local_darwin.go
new file mode 100644
index 0000000..375f7d2
--- /dev/null
+++ b/app/dns/hop_wire_local_darwin.go
@@ -0,0 +1,185 @@
+//go:build darwin && cgo
+
+package dns
+
+/*
+#include <dns_sd.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+extern void hopDarwinDNSReply(uintptr_t, uint32_t, int32_t, char *, uint16_t, uint16_t, uint16_t, void *, uint32_t);
+
+static void hopDNSReply(DNSServiceRef ref, DNSServiceFlags flags, uint32_t iface, DNSServiceErrorType status,
+    const char *name, uint16_t type, uint16_t class, uint16_t len, const void *data, uint32_t ttl, void *token) {
+    hopDarwinDNSReply((uintptr_t)token, flags, status, (char *)name, type, class, len, (void *)data, ttl);
+}
+
+static DNSServiceErrorType hopDNSQuery(DNSServiceRef *ref, const char *name, uint16_t type, uint16_t class, uintptr_t token) {
+    return DNSServiceQueryRecord(ref, kDNSServiceFlagsReturnIntermediates | kDNSServiceFlagsTimeout,
+        kDNSServiceInterfaceIndexAny, name, type, class, hopDNSReply, (void *)token);
+}
+*/
+import "C"
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"runtime/cgo"
+	"strings"
+	"time"
+	"unsafe"
+
+	"github.com/miekg/dns"
+	"golang.org/x/sys/unix"
+)
+
+// DNS-SD selects the system's scoped resolver for the question. Keep the
+// operation on one goroutine so cancellation and callbacks cannot race ref teardown.
+func (*LocalNameServer) exchangeWire(ctx context.Context, question dns.Question, packet []byte) ([]byte, error) {
+	result, err := newDarwinWireReply(question, packet)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+
+	token := cgo.NewHandle(result)
+	defer token.Delete()
+	name := C.CString(question.Name)
+	defer C.free(unsafe.Pointer(name))
+	var ref C.DNSServiceRef
+	if status := C.hopDNSQuery(&ref, name, C.uint16_t(question.Qtype), C.uint16_t(question.Qclass), C.uintptr_t(token)); status != 0 {
+		return nil, fmt.Errorf("system DNS query failed (%d)", status)
+	}
+	defer C.DNSServiceRefDeallocate(ref)
+
+	fd := C.DNSServiceRefSockFD(ref)
+	if fd < 0 {
+		return nil, errors.New("system DNS query has no socket")
+	}
+	fds := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLIN}}
+	deadline, _ := ctx.Deadline()
+	for !result.done && result.err == nil {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		left := time.Until(deadline)
+		if left <= 0 {
+			return nil, context.DeadlineExceeded
+		}
+		// DNS-SD owns the socket. Only it may read or close it. A short poll
+		// interval bounds cancellation latency even with no daemon response.
+		wait := min(left, 100*time.Millisecond)
+		n, err := unix.Poll(fds, int((wait+time.Millisecond-1)/time.Millisecond))
+		if errors.Is(err, unix.EINTR) {
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		if n == 0 {
+			continue
+		}
+		if fds[0].Revents&unix.POLLIN == 0 {
+			return nil, errors.New("system DNS socket closed")
+		}
+		if status := C.DNSServiceProcessResult(ref); status != 0 {
+			return nil, fmt.Errorf("system DNS response failed (%d)", status)
+		}
+	}
+	if result.err != nil {
+		return nil, result.err
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return result.packet, nil
+}
+
+// DNS-SD returns individual records with uncompressed wire-format RDATA.
+// Build a response containing the original ID and question, then append those
+// records directly. Keep the receipt of a CNAME separate from its final answer.
+type darwinWireReply struct {
+	packet    []byte
+	qtype     uint16
+	sawAnswer bool
+	done      bool
+	err       error
+}
+
+func newDarwinWireReply(q dns.Question, packet []byte) (*darwinWireReply, error) {
+	if len(packet) < 12 || len(packet) > dns.MaxMsgSize || !dns.IsFqdn(q.Name) || strings.IndexByte(q.Name, 0) >= 0 {
+		return nil, errors.New("invalid system DNS question")
+	}
+	msg := dns.Msg{
+		MsgHdr: dns.MsgHdr{
+			Id: binary.BigEndian.Uint16(packet), Response: true,
+			RecursionDesired: packet[2]&1 != 0, RecursionAvailable: true, CheckingDisabled: packet[3]&0x10 != 0,
+		},
+		Question: []dns.Question{q},
+	}
+	wire, err := msg.Pack()
+	if err != nil {
+		return nil, err
+	}
+	return &darwinWireReply{packet: wire, qtype: q.Qtype}, nil
+}
+
+//export hopDarwinDNSReply
+func hopDarwinDNSReply(token C.uintptr_t, flags C.uint32_t, status C.int32_t, owner *C.char, rrtype, class, size C.uint16_t, data unsafe.Pointer, ttl C.uint32_t) {
+	result := cgo.Handle(token).Value().(*darwinWireReply)
+	if result.done || result.err != nil {
+		return
+	}
+	if status != C.kDNSServiceErr_NoError {
+		result.finishStatus(int32(status))
+		return
+	}
+	if flags&C.kDNSServiceFlagsAdd != 0 {
+		result.appendRecord(C.GoString(owner), uint16(rrtype), uint16(class), uint32(ttl), unsafe.Slice((*byte)(data), int(size)))
+	}
+	result.done = result.sawAnswer && flags&C.kDNSServiceFlagsMoreComing == 0
+}
+
+const (
+	darwinNoSuchName   = C.kDNSServiceErr_NoSuchName
+	darwinNoSuchRecord = C.kDNSServiceErr_NoSuchRecord
+)
+
+func (r *darwinWireReply) finishStatus(status int32) {
+	switch status {
+	case darwinNoSuchName:
+		r.packet[3] |= dns.RcodeNameError
+	case darwinNoSuchRecord:
+		// The system reports no record of the requested type (NODATA).
+	default:
+		r.err = fmt.Errorf("system DNS returned status %d", status)
+	}
+	r.done = true
+}
+
+func (r *darwinWireReply) appendRecord(owner string, rrtype, class uint16, ttl uint32, data []byte) {
+	var name [255]byte
+	n, err := dns.PackDomainName(owner, name[:], 0, nil, false)
+	if err != nil {
+		r.err = err
+		return
+	}
+	if n+10+len(data) > dns.MaxMsgSize-len(r.packet) {
+		r.err = errors.New("system DNS answer exceeds maximum packet size")
+		return
+	}
+	r.packet = append(r.packet, name[:n]...)
+	r.packet = binary.BigEndian.AppendUint16(r.packet, rrtype)
+	r.packet = binary.BigEndian.AppendUint16(r.packet, class)
+	r.packet = binary.BigEndian.AppendUint32(r.packet, ttl)
+	r.packet = binary.BigEndian.AppendUint16(r.packet, uint16(len(data)))
+	r.packet = append(r.packet, data...)
+	binary.BigEndian.PutUint16(r.packet[6:8], binary.BigEndian.Uint16(r.packet[6:8])+1)
+	r.sawAnswer = r.sawAnswer || rrtype == r.qtype || r.qtype == dns.TypeANY
+}
