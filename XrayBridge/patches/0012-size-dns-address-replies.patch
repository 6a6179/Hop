+
+const maxDNSReplySize = wire.MaxMsgSize
+
+func udpReplyLimit(query *wire.Msg) int {
+	if opt := query.IsEdns0(); opt != nil {
+		return max(wire.MinMsgSize, min(1232, int(opt.UDPSize())))
+	}
+	return wire.MinMsgSize
+}
+
+func addressReplyLimit(packet []byte, udp bool) int {
+	if !udp {
+		return wire.MaxMsgSize
+	}
+	// Most legacy queries have no additional records. Only decode EDNS when present.
+	if len(packet) >= 12 && binary.BigEndian.Uint16(packet[10:12]) != 0 {
+		var query wire.Msg
+		if query.Unpack(packet) == nil {
+			return udpReplyLimit(&query)
+		}
+	}
+	return wire.MinMsgSize
+}
