+func TestHopDNSTruncatedReplyCompletesUDPExchange(t *testing.T) {
+	u := testDNSHandler(t)
+	occupyOtherSources(u)
+	query := testDNSPacket(t, 7, dnsmessage.TypeAAAA, false)
+	c := sendTestUDP(u, 15000, testDNSGateway, query)
+	// TC completes only the matching, fully delivered wire message.
+	wrong := testDNSPacket(t, 8, dnsmessage.TypeAAAA, true)
+	wrong[2] |= 2
+	answerTestDNS(t, c, wrong)
+	if sendTestUDP(u, 15001, testDNSGateway, query) != nil {
+		t.Fatal("unmatched truncated answer released the slot")
+	}
+	reply := testDNSPacket(t, 7, dnsmessage.TypeAAAA, true)
+	reply[2] |= 2
+	malformed := append([]byte(nil), reply...)
+	malformed[7] = 1 // The declared answer is absent.
+	answerTestDNS(t, c, malformed)
+	if sendTestUDP(u, 15001, testDNSGateway, query) != nil {
+		t.Fatal("incomplete packet released the slot")
+	}
+	answerTestDNS(t, c, reply)
+	if sendTestUDP(u, 15001, testDNSGateway, query) == nil {
+		t.Fatal("delivered TC answer retained the UDP mapping")
+	}
+}
