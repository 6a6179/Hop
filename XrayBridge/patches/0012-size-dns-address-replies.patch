+func TestHopAddressReplySizing(t *testing.T) {
+	for _, family := range []struct {
+		qtype dnsmessage.Type
+		ip    net.IP
+	}{
+		{dnsmessage.TypeA, net.ParseIP("192.0.2.1")},
+		{dnsmessage.TypeAAAA, net.ParseIP("2001:db8::1")},
+	} {
+		for _, tc := range []struct {
+			name         string
+			edns         uint16
+			udp          bool
+			count, limit int
+			truncated    bool
+			rcode        int
+		}{
+			{"small", 0, true, 1, 512, false, 0},
+			{"legacy-udp", 0, true, 40, 512, true, 0},
+			{"EDNS", 1232, true, 40, 1232, false, 0},
+			{"EDNS-ceiling", 4096, true, 110, 1232, true, 0},
+			{"TCP-retry", 0, false, 600, 65535, false, 0},
+			{"TCP-frame-limit", 0, false, 5000, 65535, false, wire.RcodeServerFailure},
+		} {
+			t.Run(family.qtype.String()+"/"+tc.name, func(t *testing.T) {
+				var query wire.Msg
+				query.SetQuestion("pool.example.", uint16(family.qtype))
+				if tc.edns != 0 {
+					query.SetEdns0(tc.edns, false)
+				}
+				raw, err := query.Pack()
+				if err != nil {
+					t.Fatal(err)
+				}
+				limit := addressReplyLimit(raw, tc.udp)
+				if limit != tc.limit {
+					t.Fatalf("limit %d, want %d", limit, tc.limit)
+				}
+				ips := make([]net.IP, tc.count)
+				for i := range ips {
+					ips[i] = family.ip
+				}
+				h := Handler{client: hopDNSLookup{lookup: func(_ string, o dns.IPOption) ([]net.IP, uint32, error) {
+					if !o.FakeEnable {
+						t.Fatal("lost FakeDNS address lookup")
+					}
+					return ips, 60, nil
+				}}}
+				var out hopDNSReply
+				h.handleIPQuery(context.Background(), query.Id, family.qtype, query.Question[0].Name, limit, &out, nil)
+				if len(out.packets) != 1 || len(out.packets[0]) > limit {
+					t.Fatalf("invalid reply count or size")
+				}
+				var reply wire.Msg
+				if err := reply.Unpack(out.packets[0]); err != nil {
+					t.Fatal(err)
+				}
+				wantAnswers := tc.count
+				if tc.truncated || tc.rcode != 0 {
+					wantAnswers = 0
+				}
+				if !reply.Response || reply.Id != query.Id || len(reply.Question) != 1 || reply.Question[0] != query.Question[0] || reply.Truncated != tc.truncated || reply.Rcode != tc.rcode || len(reply.Answer) != wantAnswers {
+					t.Fatalf("unexpected reply ID %d, question %v, TC %t, rcode %d, answers %d", reply.Id, reply.Question, reply.Truncated, reply.Rcode, len(reply.Answer))
+				}
+			})
+		}
+	}
+}
