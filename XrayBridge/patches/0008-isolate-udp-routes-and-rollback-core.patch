diff --git a/proxy/tun/hop_udp_route_test.go b/proxy/tun/hop_udp_route_test.go
new file mode 100644
index 0000000..4def856
--- /dev/null
+++ b/proxy/tun/hop_udp_route_test.go
@@ -0,0 +1,69 @@
+package tun
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+func TestHopUDPDispatchesEachDestination(t *testing.T) {
+	dispatches := make(chan net.Destination, 2)
+	u := newUdpConnectionHandler(func(_ net.Conn, dst net.Destination) { dispatches <- dst }, nil)
+	defer u.close()
+
+	first := net.UDPDestination(net.ParseAddress("192.0.2.1"), 443)
+	second := net.UDPDestination(net.ParseAddress("192.0.2.2"), 443)
+	a := sendTestUDP(u, 17000, first, []byte{1})
+	b := sendTestUDP(u, 17000, second, []byte{2})
+	if a == nil || b == nil || a == b || sendTestUDP(u, 17000, first, []byte{3}) != a {
+		t.Fatal("one dispatcher per source and destination was expected")
+	}
+	remaining := map[net.Destination]bool{first: true, second: true}
+	for range 2 {
+		select {
+		case dst := <-dispatches:
+			if !remaining[dst] {
+				t.Fatalf("unexpected dispatch to %v", dst)
+			}
+			delete(remaining, dst)
+		case <-time.After(time.Second):
+			t.Fatal("missing destination dispatch")
+		}
+	}
+
+	for _, pair := range []struct {
+		c       *udpConn
+		payload byte
+	}{{a, 1}, {b, 2}, {a, 3}} {
+		var packet [1]byte
+		if _, err := pair.c.Read(packet[:]); err != nil || packet[0] != pair.payload {
+			t.Fatalf("wrong queue: %v, %v", packet, err)
+		}
+	}
+	if err := a.Close(); err != nil || sendTestUDP(u, 17000, second, []byte{4}) != b {
+		t.Fatal("closing one destination affected the other")
+	}
+}
+
+func TestHopUDPRejectedFirstPacketDoesNotDispatch(t *testing.T) {
+	dispatches := make(chan net.Destination, 2)
+	u := newUdpConnectionHandler(func(_ net.Conn, dst net.Destination) { dispatches <- dst }, nil)
+	defer u.close()
+	u.budget = &atomic.Int32{}
+	u.budget.Store(udpStackBytes)
+	dst := net.UDPDestination(net.ParseAddress("192.0.2.1"), 443)
+	if c := sendTestUDP(u, 17000, dst, []byte{1}); c != nil {
+		t.Fatal("allocated an empty flow under pressure")
+	}
+	u.budget.Store(0)
+	if c := sendTestUDP(u, 17001, dst, []byte{2}); c == nil {
+		t.Fatal("failed to admit a packet after pressure subsided")
+	}
+	select {
+	case <-dispatches:
+	case <-time.After(time.Second):
+		t.Fatal("admitted packet was not dispatched")
+	}
+}
