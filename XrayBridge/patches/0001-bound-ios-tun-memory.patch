diff --git a/proxy/tun/hop_borrowed_lifetime_darwin_test.go b/proxy/tun/hop_borrowed_lifetime_darwin_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e8214a6cfc168c05ce4199ede079f28e2eb73fd6
--- /dev/null
+++ b/proxy/tun/hop_borrowed_lifetime_darwin_test.go
@@ -0,0 +1,114 @@
+//go:build darwin
+
+package tun
+
+import (
+	"errors"
+	"os"
+	"runtime"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/platform"
+	"golang.org/x/sys/unix"
+)
+
+func TestHopBorrowedTunLifetime(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[0])
+	defer unix.Close(fds[1])
+	t.Setenv(platform.TunFdKey, strconv.Itoa(fds[0]))
+
+	// Reuse the same system-owned descriptor across core restarts.
+	for i := 0; i < 3; i++ {
+		device, err := NewTun(&Config{MTU: 1280})
+		if err != nil {
+			t.Fatal(err)
+		}
+		tun := device.(*DarwinTun)
+		ownedFD := tun.tunFd
+		if ownedFD == fds[0] {
+			_ = tun.Close()
+			runtime.KeepAlive(tun)
+			t.Fatal("wrapped the borrowed descriptor instead of an owned duplicate")
+		}
+		flags, err := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0)
+		if err != nil || flags&unix.FD_CLOEXEC == 0 {
+			t.Fatalf("duplicate is not close-on-exec: flags=%d err=%v", flags, err)
+		}
+		if err := tun.Start(); err != nil {
+			t.Fatalf("borrowed interface must not configure system routes: %v", err)
+		}
+		if _, err := unix.Write(fds[1], []byte{0, 0, 0, unix.AF_INET, 0x45, 0, 0, 0}); err != nil {
+			t.Fatal(err)
+		}
+		packet, err := tun.ReadPacket(make([]byte, 1284))
+		if err != nil || len(packet) != 4 || packet[0]>>4 != 4 {
+			t.Fatalf("restarted TUN cannot read: packet=%x err=%v", packet, err)
+		}
+
+		readDone := make(chan error, 1)
+		go func() {
+			_, err := tun.ReadPacket(make([]byte, 1284))
+			readDone <- err
+		}()
+		select {
+		case err := <-readDone:
+			t.Fatalf("empty socket read returned before close: %v", err)
+		case <-time.After(20 * time.Millisecond):
+		}
+		var closing sync.WaitGroup
+		for range 8 {
+			closing.Add(1)
+			go func() {
+				defer closing.Done()
+				if err := tun.Close(); err != nil {
+					t.Error(err)
+				}
+			}()
+		}
+		closing.Wait()
+		select {
+		case err := <-readDone:
+			if !errors.Is(err, os.ErrClosed) {
+				t.Fatalf("read after close: %v", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatal("Close did not wake the pending packet read")
+		}
+		if _, err := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0); !errors.Is(err, unix.EBADF) {
+			t.Fatalf("owned descriptor leaked: %v", err)
+		}
+
+		// Reuse the closed number: neither repeated Close nor GC may close it.
+		if err := unix.Dup2(fds[0], ownedFD); err != nil {
+			t.Fatal(err)
+		}
+		if err := tun.Close(); err != nil {
+			t.Fatal(err)
+		}
+		tun, device = nil, nil
+		for j := 0; j < 3; j++ {
+			runtime.GC()
+		}
+		_, originalErr := unix.FcntlInt(uintptr(fds[0]), unix.F_GETFD, 0)
+		_, reusedErr := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0)
+		_ = unix.Close(ownedFD)
+		if originalErr != nil || reusedErr != nil {
+			t.Fatalf("closed an unowned descriptor: original=%v reused=%v", originalErr, reusedErr)
+		}
+	}
+}
+
+func TestHopBorrowedTunRejectsInvalidDescriptor(t *testing.T) {
+	t.Setenv(platform.TunFdKey, "-1")
+	if device, err := NewTun(&Config{MTU: 1280}); err == nil {
+		_ = device.Close()
+		t.Fatal("accepted an invalid borrowed descriptor")
+	}
+}
diff --git a/proxy/tun/hop_budget_test.go b/proxy/tun/hop_budget_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..71d8ff8fa2e50d07b246ce8b5ba5a54417ad9948
--- /dev/null
+++ b/proxy/tun/hop_budget_test.go
@@ -0,0 +1,191 @@
+package tun
+
+import (
+	"bytes"
+	"context"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// A large stream from an outbound must pass through a small send window in order.
+func TestHopTCPBudgetAndStream(t *testing.T) {
+	for _, asBuffers := range []bool{true, false} {
+		conns := make(chan accepted, 1)
+		peer, link := newPeer(t, "10.0.0.1:1234", "10.0.0.2:80")
+		newTestStack(t, link, accept(conns))
+		peer.connect([]byte{2, 4, 5, 180, 1, 3, 3, tcpWindowShift})
+		conn := take(t, conns).conn.(*tcpConn)
+		payload := bytes.Repeat([]byte("Hop transfer test"), 32768)
+		done := make(chan error, 1)
+		go func() {
+			var err error
+			if asBuffers {
+				err = conn.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes(payload)})
+			} else {
+				_, err = conn.Write(payload)
+			}
+			done <- err
+		}()
+		received := 0
+		for received < len(payload) {
+			seg := peer.receive()
+			if seg.seq != peer.ack || len(seg.payload) == 0 {
+				continue
+			}
+			end := received + len(seg.payload)
+			if end > len(payload) || !bytes.Equal(payload[received:end], seg.payload) {
+				t.Fatal("unexpected stream contents")
+			}
+			received = end
+			conn.mu.Lock()
+			allocated := conn.sndBytes
+			conn.mu.Unlock()
+			if allocated > tcpWindow {
+				t.Fatalf("retransmission queue retained %d bytes", allocated)
+			}
+			peer.ack += uint32(len(seg.payload))
+			peer.send(peer.seq, tcpAck, nil, nil)
+		}
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestHopTCPDialLimitAndClose(t *testing.T) {
+	l := newLink()
+	sent := make(chan struct{}, 2*tcpOpening)
+	l.out = func([]byte) {
+		select {
+		case sent <- struct{}{}:
+		default:
+		}
+	}
+	result, err := NewStack(context.Background(), StackOptions{Tun: l, MTU: 1500, Addresses: []netip.Addr{netip.MustParseAddr("10.0.0.2")}, Remote: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := result.(*stack)
+	if s.window != 128<<10 {
+		t.Fatal("WireGuard window", s.window)
+	}
+	dst := netip.MustParseAddrPort("10.0.0.1:80")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var dials sync.WaitGroup
+	for range tcpOpening {
+		dials.Add(1)
+		go func() { defer dials.Done(); _, _ = s.DialTCP(ctx, dst) }()
+	}
+	for range tcpOpening {
+		select {
+		case <-sent:
+		case <-time.After(2 * time.Second):
+			t.Fatal("SYN not emitted")
+		}
+	}
+	if _, err := s.DialTCP(context.Background(), dst); err == nil {
+		t.Fatal("over-budget dial admitted")
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	dials.Wait()
+	if s.opening.Load() != 0 || s.tcpFlows != 0 {
+		t.Fatal("closed dials retained")
+	}
+}
+
+func TestHopUDPQueueBudgetAndShutdown(t *testing.T) {
+	incoming := make(chan net.Conn, udpFlowLimit)
+	handler := handler(func(c net.Conn, _ net.Destination) { incoming <- c })
+	ip, err := NewStack(context.Background(), StackOptions{Tun: newLink(), MTU: 1500}, handler)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := ip.(*stack)
+	dst := net.UDPDestination(net.ParseAddress("10.0.0.2"), 53)
+	for i := 0; i < udpFlowLimit+1; i++ {
+		src := net.UDPDestination(net.ParseAddress("10.0.0.1"), net.Port(1024+i))
+		for range 2 {
+			b := buf.NewWithSize(60000)
+			b.Extend(60000)
+			s.udp.HandlePacket(src, dst, b)
+		}
+	}
+	if len(s.udp.udpConns) != udpFlowLimit || s.udpBytes.Load() != udpStackBytes {
+		t.Fatalf("flows=%d, queued bytes=%d", len(s.udp.udpConns), s.udpBytes.Load())
+	}
+	for _, c := range s.udp.udpConns {
+		if c.queue.bytes > udpQueueBytes || len(c.queue.items) > 1 {
+			t.Fatal("per-flow budget exceeded")
+		}
+	}
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if s.udpBytes.Load() != 0 {
+		t.Fatal("queued buffers retained after close")
+	}
+	for range udpFlowLimit {
+		c := <-incoming
+		if _, err := c.Read(make([]byte, 1)); err == nil {
+			t.Fatal("closed UDP flow still readable")
+		}
+		c.Close()
+	}
+	s.udp.HandlePacket(dst, dst, buf.New())
+	if len(s.udp.udpConns) != 0 {
+		t.Fatal("flow admitted after shutdown")
+	}
+}
+
+// Close must join the exact reader started on this device before a replacement takes over.
+func TestHopReaderCloseUnderTraffic(t *testing.T) {
+	for range 8 {
+		p, l := newPeer(t, "10.0.0.1:1234", "10.0.0.2:80")
+		made, err := NewStack(context.Background(), StackOptions{Tun: l, MTU: 1500}, handler(echo))
+		if err != nil {
+			t.Fatal(err)
+		}
+		s := made.(*stack)
+		if err := s.Start(); err != nil {
+			t.Fatal(err)
+		}
+		first := s.readerDone
+		if err := s.Start(); err != nil || s.readerDone != first {
+			t.Fatal("second reader started")
+		}
+		p.udp(p.src, p.dst, "before close")
+		p.packet()
+		pkt := p.bytes(p.seq, tcpSyn, nil, nil)
+		sending := make(chan struct{})
+		go func() {
+			defer close(sending)
+			for {
+				select {
+				case <-l.done:
+					return
+				case l.in <- pkt:
+				}
+			}
+		}()
+		if err := closeInbound(s, l); err != nil {
+			t.Fatal(err)
+		}
+		<-sending
+		select {
+		case <-first:
+		default:
+			t.Fatal("reader still running")
+		}
+		if s.Start() == nil {
+			t.Fatal("started a closed stack")
+		}
+	}
+}
