diff --git a/proxy/tun/tun_darwin_hop_test.go b/proxy/tun/tun_darwin_hop_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/tun_darwin_hop_test.go
@@ -0,0 +1,109 @@
+//go:build darwin
+
+package tun
+
+import (
+	"errors"
+	"os"
+	"runtime"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/platform"
+	"golang.org/x/sys/unix"
+)
+
+func TestHopBorrowedTunLifetime(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[0])
+	defer unix.Close(fds[1])
+	t.Setenv(platform.TunFdKey, strconv.Itoa(fds[0]))
+
+	// Reuse the same system-owned descriptor across core restarts.
+	for i := 0; i < 3; i++ {
+		device, err := NewTun(&Config{MTU: 1280})
+		if err != nil {
+			t.Fatal(err)
+		}
+		tun := device.(*DarwinTun)
+		ownedFD := tun.tunFd
+		if ownedFD == fds[0] {
+			_ = tun.Close()
+			runtime.KeepAlive(tun)
+			t.Fatal("wrapped the borrowed descriptor instead of an owned duplicate")
+		}
+		flags, err := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0)
+		if err != nil || flags&unix.FD_CLOEXEC == 0 {
+			t.Fatalf("duplicate is not close-on-exec: flags=%d err=%v", flags, err)
+		}
+		if err := tun.Start(); err != nil {
+			t.Fatalf("borrowed interface must not configure system routes: %v", err)
+		}
+		if _, err := unix.Write(fds[1], []byte{0, 0, 0, unix.AF_INET, 0x45, 0, 0, 0}); err != nil {
+			t.Fatal(err)
+		}
+		version, packet, err := tun.ReadPacket()
+		if err != nil || packet == nil || version != 4 {
+			t.Fatalf("restarted TUN cannot read: version=%d err=%v", version, err)
+		}
+		packet.DecRef()
+
+		readDone := make(chan error, 1)
+		go func() {
+			_, packet, err := tun.ReadPacket()
+			if packet != nil {
+				packet.DecRef()
+			}
+			readDone <- err
+		}()
+		select {
+		case err := <-readDone:
+			t.Fatalf("empty socket read returned before close: %v", err)
+		case <-time.After(20 * time.Millisecond):
+		}
+		if err := tun.Close(); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case err := <-readDone:
+			if !errors.Is(err, os.ErrClosed) {
+				t.Fatalf("read after close: %v", err)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatal("Close did not wake the pending packet read")
+		}
+		if _, err := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0); !errors.Is(err, unix.EBADF) {
+			t.Fatalf("owned descriptor leaked: %v", err)
+		}
+
+		// Reuse the closed number: neither repeated Close nor GC may close it.
+		if err := unix.Dup2(fds[0], ownedFD); err != nil {
+			t.Fatal(err)
+		}
+		if err := tun.Close(); err != nil {
+			t.Fatal(err)
+		}
+		tun, device = nil, nil
+		for j := 0; j < 3; j++ {
+			runtime.GC()
+		}
+		_, originalErr := unix.FcntlInt(uintptr(fds[0]), unix.F_GETFD, 0)
+		_, reusedErr := unix.FcntlInt(uintptr(ownedFD), unix.F_GETFD, 0)
+		_ = unix.Close(ownedFD)
+		if originalErr != nil || reusedErr != nil {
+			t.Fatalf("closed an unowned descriptor: original=%v reused=%v", originalErr, reusedErr)
+		}
+	}
+}
+
+func TestHopBorrowedTunRejectsInvalidDescriptor(t *testing.T) {
+	t.Setenv(platform.TunFdKey, "-1")
+	if device, err := NewTun(&Config{MTU: 1280}); err == nil {
+		_ = device.Close()
+		t.Fatal("accepted an invalid borrowed descriptor")
+	}
+}
diff --git a/proxy/tun/stack_gvisor_endpoint_hop_test.go b/proxy/tun/stack_gvisor_endpoint_hop_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/stack_gvisor_endpoint_hop_test.go
@@ -0,0 +1,83 @@
+package tun
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+type hopReadDevice struct{ reads chan chan error }
+
+func (d *hopReadDevice) ReadPacket() (byte, *stack.PacketBuffer, error) {
+	result := make(chan error, 1)
+	d.reads <- result
+	return 0, nil, <-result
+}
+func (*hopReadDevice) WritePacket(*stack.PacketBuffer) tcpip.Error { return nil }
+func (*hopReadDevice) Wait()                                       {}
+
+type hopDispatcher struct{}
+
+func (hopDispatcher) DeliverNetworkPacket(tcpip.NetworkProtocolNumber, *stack.PacketBuffer) {}
+func (hopDispatcher) DeliverLinkPacket(tcpip.NetworkProtocolNumber, *stack.PacketBuffer)    {}
+
+func hopRead(t *testing.T, d *hopReadDevice) chan error {
+	t.Helper()
+	select {
+	case result := <-d.reads:
+		return result
+	case <-time.After(time.Second):
+		t.Fatal("dispatcher did not start reading")
+		return nil
+	}
+}
+
+func TestHopLinkEndpointConcurrentCloseAndReadError(t *testing.T) {
+	for i := 0; i < 64; i++ {
+		d := &hopReadDevice{reads: make(chan chan error, 2)}
+		e := &LinkEndpoint{deviceMTU: 1280, device: d}
+		e.Attach(hopDispatcher{})
+		read := hopRead(t, d)
+		var wg sync.WaitGroup
+		wg.Add(3)
+		gate := make(chan struct{})
+		go func() { defer wg.Done(); <-gate; e.Close() }()
+		go func() { defer wg.Done(); <-gate; read <- errors.New("read closed") }()
+		go func() { defer wg.Done(); <-gate; _ = e.IsAttached() }()
+		close(gate)
+		wg.Wait()
+		e.Close()
+		if e.IsAttached() {
+			t.Fatal("closed endpoint is still attached")
+		}
+	}
+	// The fake device can signal its read returning, not the enclosing worker
+	// returning. Let its final error cleanup run under the race detector too.
+	time.Sleep(10 * time.Millisecond)
+}
+
+func TestHopLinkEndpointOldReadErrorDoesNotDetachReplacement(t *testing.T) {
+	d := &hopReadDevice{reads: make(chan chan error, 2)}
+	e := &LinkEndpoint{deviceMTU: 1280, device: d}
+	e.Attach(hopDispatcher{})
+	oldRead := hopRead(t, d)
+	e.Attach(hopDispatcher{})
+	newRead := hopRead(t, d)
+	oldRead <- errors.New("old reader closed")
+	// Observe for long enough to let the deliberately delayed old error run;
+	// a stale detach can otherwise silently stop a newly attached worker.
+	until := time.Now().Add(25 * time.Millisecond)
+	for time.Now().Before(until) {
+		if !e.IsAttached() {
+			t.Error("old reader detached replacement")
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	e.Close()
+	newRead <- errors.New("new reader closed")
+}
