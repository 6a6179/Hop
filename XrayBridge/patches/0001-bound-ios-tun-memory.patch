+
+// Close the device before waiting on a reader or flow that may be blocked
+// writing to it. A WireGuard stack fed through Input owns no reader.
+func closeInbound(ipStack Stack, device Tun) error {
+	var done chan struct{}
+	if s, ok := ipStack.(*stack); ok {
+		s.mu.Lock()
+		s.closed = true
+		done = s.readerDone
+		s.mu.Unlock()
+	}
+	err := common.CloseIfExists(device)
+	if done != nil {
+		<-done
+	}
+	return errors.Combine(err, common.CloseIfExists(ipStack))
 }
 
