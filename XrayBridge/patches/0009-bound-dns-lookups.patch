+package dns
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+func TestHopDNSBoundsUnfinishedLookupsAcrossHandlers(t *testing.T) {
+	started := make(chan struct{}, maxConcurrentDNSLookups)
+	release := make(chan struct{})
+	var resume sync.Once
+	unblock := func() { resume.Do(func() { close(release) }) }
+	defer unblock()
+
+	resolver := hopDNSLookup{lookup: func(string, dns.IPOption) ([]net.IP, uint32, error) {
+		started <- struct{}{}
+		<-release
+		return nil, 0, dns.ErrEmptyResponse
+	}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	old := Handler{client: resolver}
+	var discarded hopDNSReply
+	for i := range maxConcurrentDNSLookups {
+		if err := old.startIPQuery(ctx, uint16(i), dnsmessage.TypeA, "example.test.", &discarded, nil); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for range maxConcurrentDNSLookups {
+		select {
+		case <-started:
+		case <-time.After(time.Second):
+			t.Fatal("admitted lookup did not start")
+		}
+	}
+
+	// Stopping an old handler does not free its outstanding resolver work.
+	cancel()
+	fresh := Handler{client: resolver}
+	var busy hopDNSReply
+	if err := fresh.startIPQuery(context.Background(), 102, dnsmessage.TypeAAAA, ".", &busy, nil); err != nil {
+		t.Fatal(err)
+	}
+	if len(busy.packets) != 1 {
+		t.Fatal("overload did not produce an immediate response")
+	}
+	var msg dnsmessage.Message
+	if err := msg.Unpack(busy.packets[0]); err != nil {
+		t.Fatal(err)
+	}
+	if !msg.Response || msg.RCode != dnsmessage.RCodeServerFailure || msg.ID != 102 ||
+		len(msg.Questions) != 1 || msg.Questions[0].Type != dnsmessage.TypeAAAA || msg.Questions[0].Name.String() != "." {
+		t.Fatalf("unexpected overload response: %+v", msg)
+	}
+
+	unblock()
+	deadline := time.Now().Add(time.Second)
+	for len(dnsLookupSlots) != 0 {
+		if time.Now().After(deadline) {
+			t.Fatal("completed lookup retained a slot")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !tryAcquireDNSLookup() {
+		t.Fatal("did not resume admission")
+	}
+	releaseDNSLookup()
+}
