+// LookupIP has no caller cancellation parameter. Share the bound across all
+// handlers, including a previous core whose queries are still unwinding.
+const maxConcurrentDNSLookups = 16
+
+var dnsLookupSlots = make(chan struct{}, maxConcurrentDNSLookups)
+
+func tryAcquireDNSLookup() bool {
+	select {
+	case dnsLookupSlots <- struct{}{}:
+		return true
+	default:
+		return false
+	}
+}
+
+func releaseDNSLookup() { <-dnsLookupSlots }
+
+func (h *Handler) startIPQuery(ctx context.Context, id uint16, qType dnsmessage.Type, domain string, writer dns_proto.MessageWriter, timer *signal.ActivityTimer) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !tryAcquireDNSLookup() {
+		return h.rejectNonIPQuery(id, qType, domain, writer, dnsmessage.RCodeServerFailure)
+	}
+	go func() {
+		defer releaseDNSLookup()
+		h.handleIPQuery(ctx, id, qType, domain, writer, timer)
+	}()
+	return nil
+}
+
